# ==============================================================================
# Coleague - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env for local development or configure these variables in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# 1. DATABASE CONNECTION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. Supported providers:
# - Neon: postgresql://user:password@ep-xyz-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# - Vercel Postgres: Automatically populated if using Vercel Postgres integration
# - Local / Docker: postgresql://postgres:admin@localhost:5432/coleague
DATABASE_URL="postgresql://username:password@your-host.provider.com:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:admin@localhost:5432/coleague"

# 2. AUTHENTICATION & SECURITY (Recommended for Production)
# ------------------------------------------------------------------------------
# Secret key used for cryptographic signing of admin session cookies
# Generate a secure string (e.g., openssl rand -base64 32)
SESSION_SECRET="generate-a-secure-random-32-character-secret-string"

# Bearer token used by Vercel Cron to authenticate the /api/cron/sync endpoint
# Vercel Cron sends this header automatically if CRON_SECRET is configured
CRON_SECRET="generate-a-secure-random-token-for-cron-jobs"

# 3. INITIAL ADMIN CREDENTIALS (Optional - defaults to admin / admin123)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# 4. ESPN API CONFIGURATION (Optional - defaults provided in code)
# ------------------------------------------------------------------------------
ESPN_STANDINGS_BASE_URL="https://site.api.espn.com/apis/v2/sports/soccer"
ESPN_STATISTICS_BASE_URL="https://site.api.espn.com/apis/site/v2/sports/soccer"

# 5. CI/CD & BUILD FLAGS (Optional)
# ------------------------------------------------------------------------------
# Set to "true" if you run migrations in a separate workflow instead of during Vercel build
# SKIP_MIGRATIONS="false"
